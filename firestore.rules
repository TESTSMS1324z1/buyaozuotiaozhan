rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PUBLIC ACCESS FOR GAMEPLAY (Bypasses unauthorized-domain errors)
    match /rooms/{roomId} {
      allow read, write: if true;
      
      match /players/{playerId} {
        allow read, write: if true;
      }

      match /secrets/{playerId} {
        // We still keep a tiny bit of logic: you can read everyone's card except your own
        // But since we don't have request.auth.uid, we'll allow all for now to ensure it works.
        // The frontend will handle not showing your own card.
        allow read, write: if true;
      }
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
