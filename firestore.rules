rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId);
      allow update: if isSignedIn() && (
        // Host can update room status/topic
        request.auth.uid == resource.data.hostId ||
        // Players can trigger violation event (system update)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastViolation'])
      );

      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create: if isOwner(playerId);
        allow update: if isSignedIn() && (
          // Update own ready status
          isOwner(playerId) ||
          // Others can deduct lives (violation)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lives'])
        );
      }

      match /secrets/{playerId} {
        // ANTI-CHEATING RULE: You can read everyone's card EXCEPT your own
        allow read: if isSignedIn() && request.auth.uid != playerId;
        // Host (or creator) sets the card during game start
        // In this implementation, the host sets everyone's card
        allow create, update: if isSignedIn();
      }
    }
  }
}
